{
  "name": "update-changelog-version",
  "version": "3.1.1",
  "description": "Add a version & URL to your changelog",
  "keywords": [
    "changelog"
  ],
  "homepage": "https://github.com/nstringham/update-changelog-version#readme",
  "bugs": {
    "url": "https://github.com/nstringham/update-changelog-version/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Nate Stringham",
    "url": "https://github.com/nstringham"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nstringham/update-changelog-version.git"
  },
  "bin": "lib/cli.js",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "version": "./lib/cli.js CHANGELOG.md && git add CHANGELOG.md",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "bitbucket-url-from-git": "^1.0.0",
    "github-url-from-git": "^1.4.0",
    "giturl": "^1.0.0",
    "minimist": "^1.2.0",
    "upath": "^1.1.0"
  },
  "devDependencies": {
    "@types/github-url-from-git": "^1.5.3",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0"
    },
    "runtime": {
      "name": "node",
      "version": ">=26"
    }
  }
}
