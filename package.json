{
  "name": "update-changelog-version",
  "version": "3.1.1",
  "description": "Add a version & URL to your changelog",
  "keywords": [
    "changelog"
  ],
  "homepage": "https://github.com/nstringham/update-changelog-version#readme",
  "bugs": {
    "url": "https://github.com/nstringham/update-changelog-version/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Nate Stringham",
    "url": "https://github.com/nstringham"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nstringham/update-changelog-version.git"
  },
  "bin": "cli.js",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "version": "./cli.js CHANGELOG.md && git add CHANGELOG.md",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "bitbucket-url-from-git": "^1.0.0",
    "cross-spawn": "^4.0.2",
    "github-url-from-git": "^1.4.0",
    "giturl": "^1.0.0",
    "has-yarn": "^1.0.0",
    "minimist": "^1.2.0",
    "upath": "^1.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.75.0",
    "proxyquire": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0"
    },
    "runtime": {
      "name": "node",
      "version": ">=26"
    }
  }
}
